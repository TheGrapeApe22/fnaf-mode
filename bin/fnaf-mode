#!/usr/bin/env python3
"""Control the local GNOME extension and import user-supplied GIFs."""
import argparse
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

UUID = 'fnaf-mode@local'
SCHEMA = 'org.gnome.shell.extensions.fnaf-mode'
DATA = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'fnaf-mode/config.json'
EXTENSION = DATA / 'gnome-shell/extensions' / UUID


def run(argv, **kwargs):
    return subprocess.run(argv, check=True, text=True, **kwargs)


def merge_config(defaults, overrides):
    if not isinstance(defaults, dict) or not isinstance(overrides, dict):
        raise ValueError('Config files must contain JSON objects')
    merged = defaults | overrides
    for key, value in overrides.items():
        if isinstance(value, dict) and isinstance(defaults.get(key), dict):
            merged[key] = merge_config(defaults[key], value)
    return merged


def load_config():
    defaults = json.loads(CONFIG.with_name('default.json').read_text())
    overrides = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    return merge_config(defaults, overrides)


def asset_root():
    config = load_config()
    assets = config.get('assets', {})
    if not isinstance(assets, dict):
        raise ValueError('assets must be a JSON object')
    custom = assets.get('directory', '')
    if not isinstance(custom, str) or (custom and not custom.startswith(('/', '~/'))):
        raise ValueError('assets.directory must be an absolute path or start with ~/')
    return Path(custom).expanduser() if custom else DATA / 'fnaf-mode/assets'


def setting(*args):
    env = dict(os.environ, GSETTINGS_SCHEMA_DIR=str(EXTENSION / 'schemas'))
    return run(['gsettings', *args], env=env, capture_output=True).stdout.strip()


def activation_volume():
    config = load_config()
    if not isinstance(config, dict) or not isinstance(config.get('audio', {}), dict):
        raise ValueError('Config and audio must be JSON objects')
    volume = config['audio']['systemVolumePercent']
    if (isinstance(volume, bool) or not isinstance(volume, (int, float)) or
            not math.isfinite(volume) or not 0 <= volume <= 100):
        raise ValueError('audio.systemVolumePercent must be a number from 0 to 100')
    return volume


def set_output_volume(volume):
    if tool := shutil.which('wpctl'):
        argv = [tool, 'set-volume', '@DEFAULT_AUDIO_SINK@', f'{volume:g}%']
    elif tool := shutil.which('pactl'):
        argv = [tool, 'set-sink-volume', '@DEFAULT_SINK@', f'{volume:g}%']
    else:
        raise ValueError('Setting output volume requires wpctl (WirePlumber) or pactl')
    try:
        run(argv, capture_output=True)
    except subprocess.CalledProcessError as error:
        raise ValueError('Could not set output volume: ' + (error.stderr or str(error)).strip()) from error


def status(active, verbose=False):
    # OFF needs no running Shell connection; ON must also have a loaded extension.
    if not active and not verbose:
        print('FNAF mode OFF')
        return 0
    try:
        info = run(['gnome-extensions', 'info', UUID], capture_output=True,
                   env=dict(os.environ, LC_ALL='C')).stdout
    except (OSError, subprocess.CalledProcessError):
        print(f'FNAF mode {"UNKNOWN (requested ON)" if active else "OFF"}; GNOME status unavailable')
        return 1 if active else 0
    fields = dict(line.strip().split(':', 1) for line in info.splitlines() if ':' in line)
    state = fields.get('State', '').strip()
    running = state == 'ACTIVE'
    if active and running:
        print('FNAF mode ON')
    elif active:
        print(f'FNAF mode OFF (requested ON; GNOME extension state: {state or "unknown"})')
    else:
        print('FNAF mode OFF')
    if verbose:
        print(info, end='' if info.endswith('\n') else '\n')
    return 0


def import_gif(source, name, fps):
    if not shutil.which('ffmpeg'):
        raise ValueError('GIF import needs ffmpeg: sudo apt install ffmpeg')
    if not source.is_file():
        raise ValueError(f'No such file: {source}')
    if name.startswith('.') or '/' in name or not name.strip():
        raise ValueError('Animation name must be a single, non-hidden folder name')
    root = asset_root() / 'animations'
    root.mkdir(parents=True, exist_ok=True)
    target = root / name
    if target.exists():
        raise ValueError(f'{target} already exists; choose another name')
    # Hidden temporary directory is ignored by the extension until conversion finishes.
    with tempfile.TemporaryDirectory(prefix='.import-', dir=root) as tmp:
        frames = Path(tmp) / 'frames'
        frames.mkdir()
        run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-i',
             str(source.resolve()), '-an', '-vf',
             f'fps={fps},scale=1280:1280:force_original_aspect_ratio=decrease',
             '-frames:v', '900', str(frames / 'frame-%05d.png')])
        if not list(frames.glob('*.png')):
            raise ValueError('No frames decoded')
        # Rename within the same filesystem so the shell never sees partial output.
        Path(tmp).rename(target)
    print(f'Imported {target}; set visuals.animationFps to {fps} in {CONFIG}')
    print(f'Link sounds/ tracks in {asset_root() / "audio_links.json"} under animations.{name}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command')
    for command in ('toggle', 'on', 'off', 'config', 'assets'):
        sub.add_parser(command, help='Switch FNAF mode on or off (also the default)' if command == 'toggle' else None)
    status_parser = sub.add_parser('status', help='Check whether FNAF mode is ON or OFF')
    status_parser.add_argument('--verbose', action='store_true', help='Include GNOME extension details')
    gif = sub.add_parser('import-gif', help='Convert a GIF to a frame animation (requires ffmpeg)')
    gif.add_argument('source', type=Path)
    gif.add_argument('name', help='New animation folder name')
    gif.add_argument('--fps', type=int, choices=range(1, 31), default=12, metavar='1–30')
    args = parser.parse_args()
    command = args.command or 'toggle'
    if command == 'config':
        print(CONFIG)
        return
    if command == 'assets':
        print(asset_root())
        return
    if command == 'import-gif':
        import_gif(args.source, args.name, args.fps)
        return
    if not (EXTENSION / 'schemas/gschemas.compiled').exists():
        raise ValueError('Extension is not installed; run ./deploy.sh first')
    active = setting('get', SCHEMA, 'active') == 'true'
    if command == 'status':
        return status(active, args.verbose)
    desired = command == 'on' or (command == 'toggle' and not active)
    if desired:
        volume = activation_volume()
        if setting('get', 'org.gnome.shell', 'disable-user-extensions') == 'true':
            raise ValueError('GNOME has disabled user extensions. Enable them in the Extensions app first.')
        try:
            run(['gnome-extensions', 'enable', UUID], capture_output=True)
        except subprocess.CalledProcessError as error:
            raise ValueError('GNOME could not enable the extension. Log out and back in after deployment, '
                             'then try again. Details: ' + (error.stderr or '').strip()) from error
        set_output_volume(volume)
    setting('set', SCHEMA, 'active', 'true' if desired else 'false')
    print(f'FNAF mode {"ON" if desired else "OFF"}')


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'fnaf-mode: {error}', file=sys.stderr)
        sys.exit(1)
